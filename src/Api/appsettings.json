{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AnomalyDetection": {
    "RecurrenceMinMonths": 2,
    "RecurrenceTolerancePct": 0.05,
    "MagnitudeMultiplier": 2.0,
    "AbsoluteFloor": 300.0,
    "MinHistoryMonths": 2,
    "ColdStartAbsoluteThreshold": 2000.0
  }
}
